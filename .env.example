# ===== Supabase (where submissions live) =====
# Both vars are server-side; safe to expose (anon key + RLS).
# Grab from Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ===== /admin password gate =====
# HTTP Basic Auth: username is always "admin", password is this value.
# Set this on Vercel too (Project Settings → Environment Variables).
# If unset, /admin returns 404 (no admin available).
ADMIN_PASSWORD=mmwg-change-me

# ===== WhatsApp notifications via CallMeBot =====
# Free service. Sends a WhatsApp message to your personal number each time
# a new submission arrives. Both vars must be set for notifications to fire;
# otherwise the notification is silently skipped (submission still saves).
#
# Setup (one-time, ~2 min):
#   1. Add +34 644 51 95 23 to your WhatsApp contacts as "CallMeBot".
#   2. Send to that number: "I allow callmebot to send me messages to this number"
#   3. CallMeBot replies with your personal API key. Paste it below.
#
# Your WhatsApp number, with country code, NO leading + and NO spaces.
# Example for India +91 9309371000  →  919309371000
MMWG_WHATSAPP_NUMBER=

# The API key CallMeBot sends you on activation.
MMWG_CALLMEBOT_API_KEY=

# Optional. Used in the notification message to deep-link to the admin panel.
# Defaults to http://localhost:3000/admin. Override once you deploy the
# landing page to a real domain.
MMWG_ADMIN_URL=http://localhost:3000/admin
